# Copy to .env and enter the key locally. Process environment takes precedence.
# Never put an actual key in this example file or browser JavaScript.
SMARTMAINT_ANSWER_MODE=gemini
SMARTMAINT_RETRIEVAL_MODE=vector
SMARTMAINT_GEMINI_MODEL=gemini-3.8-flash
SMARTMAINT_EMBEDDING_MODEL=gemini-embedding-001
SMARTMAINT_EMBEDDING_DIMENSIONS=768
SMARTMAINT_VECTOR_MIN_SCORE=0.45
GEMINI_API_KEY=
# Optional separate index location:
# SMARTMAINT_VECTOR_DB=.runtime/rag-vectors.sqlite3
# Offline mode: SMARTMAINT_RETRIEVAL_MODE=keyword, SMARTMAINT_ANSWER_MODE=template
# Optional same-origin HTTPS hosting (Render hostname is detected automatically):
# SMARTMAINT_ALLOWED_HOSTS=smartmaint.example.com
# SMARTMAINT_PUBLIC_ORIGIN=https://smartmaint.example.com
# SMARTMAINT_SECURE_COOKIE=1
